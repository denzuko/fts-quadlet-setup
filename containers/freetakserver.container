# ~/.config/containers/systemd/freetakserver.container
# FreeTAKServer core — rootless Podman Quadlet (user-scoped systemd)
#
# Managed by: ftsvc service account  (useradd --system --uid 2001)
# Unit scope: systemctl --user
# Install:    fts_setup.sh (run as root)
# Logs:       machinectl shell ftsvc@ -- journalctl --user -u freetakserver.service -f
#
# After dropping this file as the service account:
#   systemctl --user daemon-reload
#   systemctl --user start freetakserver.service

[Unit]
Description=FreeTAKServer - Open Source TAK Server
Documentation=https://freetakteam.github.io/FreeTAKServer-User-Docs/
After=network-online.target fts-data-volume.service fts-network.service
Wants=network-online.target fts-data-volume.service fts-network.service

[Container]
ContainerName=freetakserver
Image=ghcr.io/freetakteam/freetakserver:latest
AutoUpdate=registry

# EnvironmentFile path is relative to the service account's quadlet dir.
# fts_setup.sh installs this file alongside the unit.
EnvironmentFile=%h/.config/containers/systemd/fts.env

# Data package address — inherits FTS_IP from env file at runtime
Environment=FTS_DP_ADDRESS=%E{FTS_IP}

# Persistent data volume (named, managed by fts-data.volume unit)
Volume=fts-data.volume:/opt/FTSData:Z

# Isolated bridge network (fts.network unit)
Network=fts.network

# Published ports — rootless pasta networking; binds to all interfaces
# by default under the user's network namespace
PublishPort=8087:8087
PublishPort=8089:8089
PublishPort=8080:8080
PublishPort=8443:8443
PublishPort=19023:19023
PublishPort=9000:9000

# Health probe
HealthCmd=curl -sf http://localhost:19023/SystemStatus/getStatus
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s

# Security posture — rootless already constrains privileges;
# belt-and-suspenders for defence in depth
DropCapability=ALL
NoNewPrivileges=true
ReadOnly=false

Label=app=freetakserver
Label=component=core

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=120

[Install]
# User-scoped: default.target is correct for --user units
# (multi-user.target is system-scope only)
WantedBy=default.target
