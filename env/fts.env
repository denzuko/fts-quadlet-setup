# /etc/containers/systemd/fts.env
# FreeTAKServer site-local environment
# Deploy: copy to /etc/containers/systemd/fts.env and set FTS_IP
# All values here are defaults safe for a single-node LAN deployment.
# -----------------------------------------------------------------------

# ---- REQUIRED: set to the host's external/routable IP or FQDN ----------
FTS_IP=0.0.0.0

# ---- Core server ports (defaults match FTS upstream) -------------------
FTS_COT_PORT=8087
FTS_COT_PORT_S=8089
FTS_API_PORT=19023
FTS_HTTP_PORT=8080
FTS_HTTPS_PORT=8443
FTS_FED_PORT=9000
FTS_DP_PORT=8080

# ---- Data package address exposed to clients ----------------------------
# Usually same as FTS_IP; set separately if behind a NAT/proxy
FTS_DP_ADDRESS=

# ---- Security ----------------------------------------------------------
FTS_CLIENT_CERT_REQUIRED=False
FTS_DATA_PACKAGE_HOST=0.0.0.0
FTS_LOG_LEVEL=INFO

# ---- Database ----------------------------------------------------------
FTS_DB_PATH=/opt/FTSData/FTSDataBase.db

# ---- UI service --------------------------------------------------------
FTS_UI_PORT=5000
FTS_UI_WSKEY=ChangeMeNow
FTS_API_KEY=ChangeMeBearerToken
FTS_MAP_PORT=8000
FTS_MAP_PROTO=http
FTS_UI_PROTO=http
FTS_UI_SQLALCHEMY_DATABASE_URI=sqlite:////home/freetak/data/FTSServer-UI.db

# ---- MOTD / branding (optional) ----------------------------------------
FTS_MSG=Da Planet Security TAK Node
