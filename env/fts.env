# fts.env — template only; fts_setup.sh generates the live copy with openssl secrets
# Secrets (FTS_UI_WSKEY, FTS_API_KEY) are always generated — never set here
# All values are overridable via environment variables at install time

FTS_IP=
FTS_COT_PORT=8087
FTS_COT_PORT_S=8089
FTS_API_PORT=19023
FTS_HTTP_PORT=8080
FTS_HTTPS_PORT=8443
FTS_FED_PORT=9000
FTS_UI_PORT=5000
FTS_LOG_LEVEL=INFO
FTS_CLIENT_CERT_REQUIRED=False
FTS_DB_PATH=/opt/FTSData/FTSDataBase.db
FTS_UI_SQLALCHEMY_DATABASE_URI=sqlite:////home/freetak/data/FTSServer-UI.db
